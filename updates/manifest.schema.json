{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sahabatpanganlokal.id/updates/manifest.schema.json",
  "title": "Sahabat Pangan Lokal Game Update Manifest",
  "description": "Stable schema_version 1 contract for app/content/save update metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channel",
    "generated_at",
    "app",
    "content",
    "save"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "channel": {
      "const": "stable"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "version_code",
        "min_supported_version_code",
        "force_update",
        "store_url",
        "release_notes"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "version_code": {
          "type": "integer",
          "minimum": 1
        },
        "min_supported_version_code": {
          "type": "integer",
          "minimum": 1
        },
        "force_update": {
          "type": "boolean"
        },
        "store_url": {
          "type": "string"
        },
        "release_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "required",
        "version",
        "required_app_version_code",
        "format",
        "url",
        "size",
        "sha256"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$"
        },
        "required_app_version_code": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "const": "pck"
        },
        "url": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^(|[A-Fa-f0-9]{64})$"
        }
      }
    },
    "save": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}