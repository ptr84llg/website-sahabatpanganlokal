# Sahabat Pangan Lokal - deterministic repository line endings
* text=auto

# Web and documentation source: LF in repository/checkouts
.gitattributes text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.webmanifest text eol=lf
*.py text eol=lf
Caddyfile* text eol=lf

# PowerShell is edited/executed primarily on Windows
*.ps1 text eol=crlf

# Binary assets: never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
