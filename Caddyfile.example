# Snippet untuk digabungkan ke site block Caddy Sahabat Pangan Lokal yang aktif.
# Pertahankan directive `root` produksi yang sudah digunakan pada server aktual.

redir /privacy.html /privasi/ 301
redir /status.html /status/ 301

@staticAssets path /assets/*
header @staticAssets Cache-Control "public, max-age=604800"
# SITE DOWNLOAD API START
@siteDownloadApi path /api/site/v1/*
header @siteDownloadApi Cache-Control "no-store"
reverse_proxy @siteDownloadApi 127.0.0.1:8001
# SITE DOWNLOAD API END

# GAME UPDATE DISTRIBUTION START
# `/updates/` adalah namespace terpisah dari `/assets/`.
@gameUpdateManifest path /updates/manifest.json
header @gameUpdateManifest Cache-Control "no-store, max-age=0"

@gameUpdateSchema path /updates/manifest.schema.json
header @gameUpdateSchema Cache-Control "public, max-age=3600"

@gameUpdatePackages path /updates/content/*
header @gameUpdatePackages Cache-Control "public, max-age=31536000, immutable"
# GAME UPDATE DISTRIBUTION END